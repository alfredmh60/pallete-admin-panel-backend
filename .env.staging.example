# =============================================================================
# Admin panel backend — STAGING (deploy from `develop`)
# Fill REPLACE_* and secrets on the server / K8s ConfigMap+Secret.
# NODE_ENV=staging still enables TypeORM synchronize — prefer migrations in
# shared environments, or use NODE_ENV=production if you must disable sync.
# =============================================================================

NODE_ENV=staging
PORT=9051

# ── Database ──────────────────────────────────────────────────
DB_HOST=REPLACE_STAGING_DB_HOST
DB_PORT=5432
DB_USERNAME=REPLACE_STAGING_DB_USER
DB_PASSWORD=REPLACE_STAGING_DB_PASSWORD
DB_DATABASE=palette_ap_db

# ── Auth ──────────────────────────────────────────────────────
JWT_SECRET=REPLACE_STAGING_JWT_SECRET
JWT_EXPIRES_IN=7d

# ── Admin UI origin ───────────────────────────────────────────
FRONTEND_URL=https://REPLACE_STAGING_ADMIN_FRONTEND_HOST

# ── SMTP ──────────────────────────────────────────────────────
SMTP_HOST=REPLACE_SMTP_HOST
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=REPLACE_SMTP_USER
SMTP_PASS=REPLACE_SMTP_PASSWORD
FROM_NAME=Palette Admin
FROM_EMAIL=noreply@REPLACE_MAIL_DOMAIN

# ── Bootstrap admin (optional on server) ──────────────────────
ADMIN_PHONE=REPLACE_ADMIN_PHONE
ADMIN_EMAIL=REPLACE_ADMIN_EMAIL
ADMIN_NAME=Admin Palette

# ── Core backend bridge ───────────────────────────────────────
# Staging core API (must share the same service key as core staging).
CORE_BACKEND_URL=https://testapi.palette-tech.io
ADMIN_PANEL_SERVICE_API_KEY=REPLACE_SHARED_WITH_CORE_STAGING

# ── SMS / OTP ─────────────────────────────────────────────────
KAVENEGAR_API_KEY=REPLACE_KAVENEGAR_API_KEY
SMS_ENABLED=true
SMS_TIMEOUT_MS=8000

# ── Media — private staging bucket ────────────────────────────
STORAGE_PROVIDER=gcs
GCS_BUCKET_NAME=palette-admin-media-stage
GCS_PROJECT_ID=palette-cdn
GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcs/key.json
PUBLIC_FILES_BASE_URL=https://REPLACE_STAGING_ADMIN_API_HOST/files

# Legacy (unused when STORAGE_PROVIDER=gcs)
FILER_URL=
STATIC_SERVER_URL=

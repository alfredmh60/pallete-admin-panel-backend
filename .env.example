# =============================================================================
# Admin panel backend — local development template
# Copy to `.env` and adjust. Never commit real secrets or GCS key files.
# Branch mapping: develop → staging bucket · main → production bucket
# =============================================================================

NODE_ENV=development
PORT=9051

# ── Database ──────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=root
DB_PASSWORD=root
DB_DATABASE=palette_ap_db

# ── Auth ──────────────────────────────────────────────────────
JWT_SECRET=change-me-use-a-long-random-string
JWT_EXPIRES_IN=7d

# ── Admin UI origin (CORS / future email links) ───────────────
FRONTEND_URL=http://localhost:9052

# ── SMTP ──────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
FROM_NAME=ادمین پنل
FROM_EMAIL=noreply@admin-panel.local

# ── Bootstrap admin (`npm run create-admin`) ──────────────────
ADMIN_PHONE=09127840027
ADMIN_EMAIL=adminpalette@palette.local
ADMIN_NAME=Admin Palette

# ── Core backend bridge (seller ticketing JWT validation) ─────
# Must match ADMIN_PANEL_SERVICE_API_KEY on the core backend.
CORE_BACKEND_URL=http://localhost:9050
ADMIN_PANEL_SERVICE_API_KEY=local-dev-admin-panel-service-key-change-me

# ── SMS / OTP (Kavenegar) ─────────────────────────────────────
KAVENEGAR_API_KEY=
SMS_ENABLED=true
SMS_TIMEOUT_MS=8000

# ── Media storage (private GCS) ───────────────────────────────
# develop/staging → palette-admin-media-stage
# main/production → palette-admin-media-prod
# Local may use STORAGE_PROVIDER=static + FILER_URL (SeaweedFS) without GCP.
STORAGE_PROVIDER=gcs
GCS_BUCKET_NAME=palette-admin-media-stage
GCS_PROJECT_ID=palette-cdn
# Path to SA JSON (admin-media-storage@palette-cdn…). Never commit the key.
GOOGLE_APPLICATION_CREDENTIALS=./palette-cdn-df285c7b2c1c.json
# Browser/API-facing file proxy base (JWT required on GET /files/*)
PUBLIC_FILES_BASE_URL=http://localhost:9051/files

# Legacy static / SeaweedFS (only when STORAGE_PROVIDER=static)
FILER_URL=http://localhost:8888
STATIC_SERVER_URL=http://localhost:9050/api/v1/static-server
